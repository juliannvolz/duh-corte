// Duh Corte — modelo de dados do sistema de agendamento.
//
// Ambiente de demonstracao: SQLite (zero infra, roda em qualquer maquina).
// Producao: trocar `provider` para "postgresql" e a DATABASE_URL (ver README).
//
// Conventions:
// - minutos do dia (0..1440) para horarios de funcionamento
// - timestamps em UTC no banco; conversao para America/Sao_Paulo na borda (src/lib/time.ts)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BusinessSettings {
  id              String   @id @default("default")
  name            String
  legalName       String?
  tagline         String?
  hashtag         String?
  street          String
  neighborhood    String?
  city            String
  state           String
  zip             String?
  phone           String
  whatsapp        String
  email           String?
  pixKey          String?
  instagram       String?
  ratingValue     Float    @default(5)
  ratingCount     Int      @default(0)
  primaryColor    String   @default("#0A0A0A")
  accentColor     String   @default("#C8952B")
  cancelWindowMin Int      @default(60)
  minLeadMin      Int      @default(60)
  maxAdvanceDays  Int      @default(60)
  bufferMin       Int      @default(15)
  slotStepMin     Int      @default(15)
  penaltyHours    Int      @default(12)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  weekdays        Weekday[]
}

model Weekday {
  id        String         @id @default(cuid())
  weekday   Int
  openMin   Int
  closeMin  Int
  closed    Boolean        @default(false)
  settings  BusinessSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  settingsId String        @default("default")

  @@unique([weekday, settingsId])
}

model Professional {
  id          String   @id @default(cuid())
  name        String
  role        String
  bio         String?
  specialty  String?
  photo       String?
  active      Boolean  @default(true)
  order       Int      @default(0)
  confirmed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  hours       ProfessionalHours[]
  services    ProfessionalService[]
  appointments Appointment[]
  timeOff     TimeOff[]
}

model ProfessionalHours {
  id            String      @id @default(cuid())
  professionalId String
  weekday       Int
  openMin       Int
  closeMin      Int
  professional  Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, weekday])
}

model ServiceCategory {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  blurb    String?
  order    Int       @default(0)
  services Service[]
}

model Service {
  id             String   @id @default(cuid())
  name           String
  description    String?
  categoryId     String
  durationMin    Int
  priceCents     Int
  priceConfirmed Boolean  @default(false)
  featured       Boolean  @default(false)
  active         Boolean  @default(true)
  category       ServiceCategory @relation(fields: [categoryId], references: [id])
  professionals  ProfessionalService[]
  appointments   Appointment[]

  @@index([categoryId])
}

model ProfessionalService {
  id            String      @id @default(cuid())
  professionalId String
  serviceId     String
  priceCents    Int?
  professional  Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service       Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([professionalId, serviceId])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  notes     String?
  /// Programa de fidelidade: saldo de pontos (1 ponto = R$ 1 gasto).
  points    Int      @default(0)
  /// Codigo de indicacao do cliente (ex.: DUC-7F3A).
  referralCode String? @unique
  /// Identificador da conta social (Google) vinculada a este cliente.
  /// Permite reconhecer o cliente logado sem depender do e-mail.
  googleId  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  appointments Appointment[]
  subscriptions Subscription[]
  pointEntries PointEntry[]
  rewards     Reward[]
  feedbacks   Feedback[]
  referralsSent Referral[] @relation("ReferralReferrer")
  referralsReceived Referral[] @relation("ReferralReferee")
}

/// Extrato de pontos (toda entrada/saida fica registrada).
model PointEntry {
  id           String   @id @default(cuid())
  customerId   String
  delta        Int
  reason       String
  appointmentId String?
  createdAt    DateTime @default(now())
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

/// Recompensa liberada pelo programa de fidelidade.
model Reward {
  id         String   @id @default(cuid())
  customerId String
  label      String
  /// "desconto" (valor em reais) ou "corte" (corte gratis)
  kind       String
  valueCents Int
  pointsCost Int
  status     String   @default("available")
  createdAt  DateTime @default(now())
  usedAt     DateTime?
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, status])
}

/// Indicacao: quem indicou e quem foi indicado.
model Referral {
  id           String   @id @default(cuid())
  referrerId   String
  refereeId    String
  bonusPoints  Int      @default(30)
  rewardedAt   DateTime?
  createdAt    DateTime @default(now())
  referrer     Customer @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee      Customer @relation("ReferralReferee", fields: [refereeId], references: [id], onDelete: Cascade)

  @@unique([refereeId])
}

model Appointment {
  id            String   @id @default(cuid())
  customerId    String
  serviceId     String
  professionalId String
  startsAt      DateTime
  endsAt        DateTime
  status        String   @default("pending")
  priceCents    Int
  notes         String?
  source        String   @default("site")
  idempotencyKey String? @unique
  /// Codigo de indicacao usado na reserva (programa de fidelidade).
  referralCode  String?
  /// Plano do Clube do Assinante escolhido na reserva (ativado na loja).
  planId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service       Service  @relation(fields: [serviceId], references: [id])
  professional  Professional @relation(fields: [professionalId], references: [id])
  payment       Payment?
  feedback      Feedback?

  @@index([professionalId, startsAt])
  @@index([customerId])
}

/// Avaliacao do cliente sobre um atendimento concluido.
model Feedback {
  id            String   @id @default(cuid())
  appointmentId String   @unique
  customerId    String
  /// Nota de 1 a 5.
  rating        Int
  text          String?
  /// Quando marcado, o depoimento aparece no site (secao de avaliacoes).
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([published, createdAt])
}

model TimeOff {
  id            String      @id @default(cuid())
  professionalId String?
  startsAt      DateTime
  endsAt        DateTime
  reason        String?
  professional  Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)
}

model Plan {
  id            String   @id @default(cuid())
  name          String
  description   String?
  priceCents    Int
  period        String   @default("mensal")
  perks         String   @default("[]")
  highlight     Boolean  @default(false)
  priceConfirmed Boolean @default(false)
  active        Boolean  @default(true)
  subscriptions Subscription[]
}

model Subscription {
  id         String   @id @default(cuid())
  customerId String
  planId     String
  status     String   @default("active")
  startsAt   DateTime @default(now())
  endsAt     DateTime?
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan       Plan     @relation(fields: [planId], references: [id])
  payments   Payment[]
}

model Payment {
  id             String   @id @default(cuid())
  appointmentId  String?  @unique
  subscriptionId String?
  method         String
  amountCents    Int
  status         String   @default("pending")
  reference      String?
  pixPayload     String?
  createdAt      DateTime @default(now())
  appointment    Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
}

model GalleryItem {
  id        String @id @default(cuid())
  src       String
  alt       String
  caption   String?
  tag       String?
  order     Int    @default(0)
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String @id @default(cuid())
  author    String
  initials  String
  rating    Int    @default(5)
  text      String
  source    String @default("Google")
  sourceUrl String?
  order     Int    @default(0)
}

model PendingItem {
  id     String @id
  label  String
  detail String?
  source String @default("interno")
  done   Boolean @default(false)
}
