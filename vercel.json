{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install --no-audit --no-fund",
  "buildCommand": "npm run db:postgres && prisma generate && next build",
  "regions": ["gru1"],
  "crons": [
    {
      "path": "/api/cron/lembretes",
      "schedule": "0 11 * * *"
    }
  ]
}
