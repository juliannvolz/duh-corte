{
  "name": "duh-corte",
  "version": "0.1.0",
  "private": true,
  "description": "Site institucional + sistema de agendamento da Duh Corte Barbearia (Jaraguá do Sul/SC)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "images:process": "tsx scripts/process-images.ts",
    "data:collect": "node scripts/collect.mjs && node scripts/collect-posts.mjs",
    "qa:screens": "node scripts/qa-screens.mjs",
    "postinstall": "prisma generate",
    "pdf:gerar": "tsx scripts/gerar-pdf.mts",
    "db:postgres": "tsx scripts/prepare-db.mts postgres",
    "db:sqlite": "tsx scripts/prepare-db.mts sqlite"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lenis": "^1.3.8",
    "lucide-react": "^0.545.0",
    "motion": "^12.23.12",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "lighthouse": "^13.5.0",
    "marked": "^18.1.1",
    "playwright-core": "^1.64.1",
    "prisma": "^6.16.2",
    "sharp": "^0.34.4",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vercel": "^65.0.0",
    "vitest": "^5.0.5"
  }
